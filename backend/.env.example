# Inspectra Environment Configuration
# Server Port & Host
HOST=127.0.0.1
PORT=8000

# Security & Limits
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_CONTENT_LENGTH=10000

# Scoring Thresholds
SUSPICIOUS_THRESHOLD=25

# Optional External Reputation Services (leave empty if not configured)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional LLaMA / AI Model Integration
# Set LLAMA_ENABLED=true to enable semantic analysis
LLAMA_ENABLED=false

# Provider: 'ollama' (local private execution) or 'openai_compatible' (Groq, vLLM, Together)
LLAMA_PROVIDER=ollama
LLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_MODEL=llama3.2
LLAMA_API_KEY=
LLAMA_TIMEOUT_SECONDS=4.0
